{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "viem": ["../../rugshield-402/node_modules/viem"],
      "viem/*": ["../../rugshield-402/node_modules/viem/*"]
    }
  },
  "include": ["src/**/*"]
}
